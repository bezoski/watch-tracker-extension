{
  "manifest_version": 3,
  "name": "Watch Tracker",
  "version": "1.0.0",
  "description": "Tracks what you watch on Netflix and Disney+ and keeps the history locally.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Watch Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["storage.js", "content-scripts/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["storage.js", "content-scripts/disneyplus.js"],
      "run_at": "document_idle"
    }
  ]
}
